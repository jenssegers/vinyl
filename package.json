{
  "name": "vinyl",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"pnpm:dev:client\" \"pnpm:dev:server\"",
    "dev:client": "vite --config client/vite.config.ts",
    "dev:server": "node --env-file-if-exists=.env --watch server/src/index.ts",
    "build": "vite --config client/vite.config.ts build",
    "start": "node --env-file-if-exists=.env server/src/index.ts",
    "setup:spotify": "node --env-file-if-exists=.env server/src/spotify/setup.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "@fastify/sse": "^0.6.1",
    "@fastify/static": "^10.1.11",
    "colorthief": "^3.5.0",
    "consola": "^3.4.2",
    "fastify": "^5.12.8",
    "open": "^11.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.21.0"
}
