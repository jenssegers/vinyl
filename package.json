{
  "name": "vinyl",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite --config client/vite.config.ts",
    "dev:server": "tsx watch server/src/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite --config client/vite.config.ts build",
    "build:server": "tsup --config server/tsup.config.ts",
    "start": "node server/dist/index.js",
    "setup:spotify": "tsx server/src/setup-spotify.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check --write ."
  },
  "dependencies": {
    "@clack/prompts": "^1.6.0",
    "@fastify/static": "^9.1.3",
    "colorthief": "^3.3.1",
    "consola": "^3.4.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "open": "^11.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/colorthief": "^2.6.1",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "tailwindcss": "^4.3.1",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3",
    "vite": "^8.1.0"
  }
}
