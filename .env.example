# Spotify app credentials — create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_client_id_here

# Port used only during setup (must not conflict with the server port)
SPOTIFY_SETUP_PORT=3001

# Redirect URI registered in your Spotify app (default: http://127.0.0.1:3001/auth/callback)
SPOTIFY_REDIRECT_URI=

# Server port (default: 3000)
PORT=3000

# Set to 1 to log screen commands instead of running wlr-randr (auto on non-Linux)
VINYL_FAKE_SCREEN=

# Override the tokens file location (default: ~/.config/vinyl/tokens.json)
VINYL_TOKENS_PATH=
