# Spotify app credentials: create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_client_id_here

# Port used only during setup (must not conflict with the server port)
SPOTIFY_SETUP_PORT=3001

# Redirect URI registered in your Spotify app (default: http://127.0.0.1:3001/auth/callback)
SPOTIFY_REDIRECT_URI=

# Server port (default: 3000)
PORT=3000

# Milliseconds the screen stays on after Spotify pauses (default: 10000 = 10s)
VINYL_PAUSE_TO_OFF_MS=10000

# Location for sunset and sunrise, in decimal degrees (default: 50.94 and 3.87, Bavegem, Belgium)
VINYL_LATITUDE=
VINYL_LONGITUDE=

# Backlight brightness in percent, 0-100 (defaults: 75 by day, 25 after sunset)
VINYL_DAY_BRIGHTNESS=75
VINYL_NIGHT_BRIGHTNESS=25

# Set to 1 to log screen and backlight commands instead of running them (auto on non-Linux)
VINYL_FAKE_SCREEN=

# Override the tokens file location (default: ~/.config/vinyl/tokens.json)
VINYL_TOKENS_PATH=

# Comma-separated, case-insensitive parts of Spotify device names or IDs to show (default: all)
# e.g. `arc` matches `Arc + 1`
VINYL_ALLOWED_DEVICES=
